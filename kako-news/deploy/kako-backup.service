# پشتیبان‌گیری روزانه از دیتابیس کاکو نیوز
[Unit]
Description=کاکو نیوز — پشتیبان‌گیری دیتابیس
After=postgresql.service

[Service]
Type=oneshot
User=kako
Group=kako
WorkingDirectory=/opt/kako-news
EnvironmentFile=/opt/kako-news/.env
ExecStart=/opt/kako-news/deploy/backup.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kako-backup
