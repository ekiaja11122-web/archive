{
  "name": "kako-news",
  "version": "0.1.0",
  "description": "سامانهٔ خبرخوان و انتشار خودکار محتوا برای خبرگزاری محلی کاکو نیوز (شیراز)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "kako": "node --env-file-if-exists=.env --experimental-strip-types src/cli/index.ts",
    "migrate": "npm run kako -- migrate",
    "db:status": "npm run kako -- db:status",
    "config:check": "npm run kako -- config:check",
    "sources:sync": "npm run kako -- sources:sync",
    "sources:list": "npm run kako -- sources:list",
    "collect": "npm run kako -- collect",
    "worker": "npm run kako -- worker",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "pg": "^8.13.1",
    "rss-parser": "^3.13.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}
