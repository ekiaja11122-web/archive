# ============================================================
#  کاکو نیوز — نمونهٔ فایل تنظیمات محیطی
#  این فایل را کپی کنید به .env و مقادیر واقعی را بگذارید:
#      cp .env.example .env
#  فایل .env هرگز نباید در گیت کامیت شود.
# ============================================================

# --- عمومی -------------------------------------------------
NODE_ENV=development
# سطح لاگ: debug | info | warn | error
LOG_LEVEL=info
# منطقهٔ زمانی مورد استفاده برای زمان‌بندی و نمایش تاریخ‌ها
TZ=Asia/Tehran

# --- دیتابیس (PostgreSQL) ----------------------------------
DATABASE_URL=postgres://kako:kako@localhost:5432/kako_news
# اگر سرور دیتابیس SSL می‌خواهد (مثلاً سرویس ابری) این را true کنید
DATABASE_SSL=false

# --- OpenAI ------------------------------------------------
# کلید را از https://platform.openai.com/api-keys بگیرید
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# مدل بازنویسی خبر (در کانفیگ قابل تغییر است — اینجا فقط پیش‌فرض)
OPENAI_MODEL=gpt-4o-mini
# اگر از پروکسی یا سرویس سازگار با OpenAI استفاده می‌کنید
OPENAI_BASE_URL=https://api.openai.com/v1

# --- تلگرام ------------------------------------------------
# توکن ربات را از @BotFather بگیرید
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# شناسهٔ کانال؛ مثل @kakonews یا شناسهٔ عددی مثل -1001234567890
# ربات باید در کانال ادمین باشد.
TELEGRAM_CHANNEL_ID=@kakonews

# --- وردپرس (سایت کاکو نیوز) -------------------------------
WORDPRESS_URL=https://kakonews.ir
# نام کاربری وردپرس و «رمز برنامه» (Application Password)
# ساخت رمز برنامه: پیشخوان وردپرس ← کاربران ← پروفایل ← Application Passwords
WORDPRESS_USERNAME=kako-bot
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# --- پنل مدیریت --------------------------------------------
ADMIN_PORT=7799
# نشانی‌ای که پنل روی آن گوش می‌دهد (برای دسترسی از بیرون 0.0.0.0)
ADMIN_HOST=127.0.0.1
# نام کاربری ورود به پنل تأیید
ADMIN_USERNAME=admin
# رمز عبور پنل (در اولین اجرا با آن کاربر ادمین ساخته می‌شود)
ADMIN_PASSWORD=change-me-please
# کلید امضای کوکی نشست — یک رشتهٔ تصادفی بلند بگذارید
# ساخت مقدار تصادفی:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=please-generate-a-random-64-char-hex-string
